# ============================================
# AMOREA Brain Care - 환경 변수 설정
# ============================================
# 이 파일을 .env.local로 복사하고 값을 채워주세요

# --------------------------------------------
# Supabase (필수)
# https://supabase.com/dashboard 에서 발급
# --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --------------------------------------------
# OpenAI API (필수)
# https://platform.openai.com/api-keys 에서 발급
# 사용 기능: AI 메시지, 맞춤 루틴, TTS, STT
# --------------------------------------------
OPENAI_API_KEY=sk-...

# OpenAI 모델 설정 (선택 - 기본값 사용 가능)
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_STT_MODEL=whisper-1
OPENAI_IMAGE_MODEL=dall-e-3

# --------------------------------------------
# Kakao (소셜 로그인 & 공유)
# https://developers.kakao.com 에서 발급
# --------------------------------------------
NEXT_PUBLIC_KAKAO_JS_KEY=...
KAKAO_REST_API_KEY=...
KAKAO_CLIENT_SECRET=...

# --------------------------------------------
# Google (소셜 로그인 & Analytics)
# --------------------------------------------
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --------------------------------------------
# 푸시 알림 (Web Push - VAPID)
# npx web-push generate-vapid-keys 로 생성
# --------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...

# --------------------------------------------
# 앱 설정
# --------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AMOREA Brain Care

# --------------------------------------------
# 이메일 (선택 - Resend)
# https://resend.com 에서 발급
# --------------------------------------------
RESEND_API_KEY=...
